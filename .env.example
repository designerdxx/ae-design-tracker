# AskEdgar Tracker — Airtable backend (server-side only).
# Copy to .env.local for `vercel dev`, and set the same two in Vercel project settings.
# The browser never sees these; only the /api/* functions read them.

# Airtable Personal Access Token with data.records:read + data.records:write on the base.
# Create at https://airtable.com/create/tokens
AIRTABLE_TOKEN=

# The "AskEdgar Tracker" base ID (already built + seeded).
AIRTABLE_BASE_ID=appNdq7AL0ebUvYBP
