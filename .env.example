# AskEdgar Tracker — Google Drive backend (server-side only).
# Copy to .env.local for `vercel dev`, and set the same three in Vercel project settings.
# The browser never sees these; only the /api/* functions read them.

# The "AskEdgar Tracker" Drive folder ID (from its URL: .../folders/THIS_PART)
DRIVE_FOLDER_ID=

# The service account's client_email (from the downloaded JSON key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account's private_key (from the JSON key).
# Keep it on one line with literal \n escapes, wrapped in double quotes, e.g.:
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
